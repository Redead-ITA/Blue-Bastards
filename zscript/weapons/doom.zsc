class SuperShotgunReplacement : CustomInventory replaces SuperShotgun
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT3PLUS";
		Inventory.PickupSound "misc/shotgun_pkup";
		Tag "$TAG_SUPERSHOTGUN";
	}
	States
	{
	Spawn:
		WPNS A 8;
		WPNS A 8 Bright;
		WPNS AABC 2;
		WPNS DEFG 2 Bright;
		WPNS HIJA 2;
		WPNS A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1))
			{
				// welcome back int dice
				int roll_the_dice = random(0,1);
				switch (roll_the_dice) {
				case 0:
				  A_GiveInventory("SpotDevastator", 1, false);
				  break;
				case 1:
				  A_GiveInventory("SpotShotgunClassic", 1, false);
				  break;
				}
			}
			if (CheckInventory("DeathsheadFist", 1)) A_GiveInventory("DeathsheadSuperShotgun", 1, false);
		}
		Stop;
	}
}

class ChaingunReplacement : CustomInventory replaces Chaingun
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT4";
		Inventory.PickupSound "misc/hmg_pkup";
		Tag "$TAG_CHAINGUN";
	}
	States
	{
	Spawn:
		WPN4 A 8;
		WPN4 A 8 Bright;
		WPN4 AABC 2;
		WPN4 DEFG 2 Bright;
		WPN4 HIJA 2;
		WPN4 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1))
			{
				int roll_the_dice = random(0,1);
				switch (roll_the_dice) {
				case 0:
				  A_GiveInventory("SpotChaingun", 1, false);
				  break;
				case 1:
				  A_GiveInventory("SpotM249", 1, false);
				  break;
				}
			}
			if (CheckInventory("DeathsheadFist", 1))
			{
				int roll_the_dice = random(0,2);
				switch (roll_the_dice) {
				case 0:
				  A_GiveInventory("DeathsheadMAC10", 1, false);
				  break;
				case 1:
				  A_GiveInventory("DeathsheadM4", 1, false);
				  break;
				case 2:
				  A_GiveInventory("DeathsheadSG550", 1, false);
				  break;
				}
			}
		}
		Stop;
	}
}

