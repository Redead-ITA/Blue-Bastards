class ChickenHeal : Medikit
{
	Default
	{
		Inventory.PickupSound "misc/gulp";
		Inventory.PickupMessage "$GOTCHICKEN";
	}
	States
	{
	Spawn:
		CHIK ABCDEF 3;
		Loop;
	}
}

