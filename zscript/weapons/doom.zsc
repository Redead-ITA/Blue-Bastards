	Spawn:
		ROCK A -1;
		Stop;
	Pickup:
		TNT1 A 0
		{
			A_GiveInventory("RocketAmmo", 1, false);
			if (CheckInventory("SpotMallet", 1)) {	}
			if (CheckInventory("DeathsheadFist", 1))
			{ 
				A_GiveInventory("BBDeathsheadGrenade", A_ammomultiplier(2), false);
			}
		}
		Stop;
	}
}
	

