class DeathsheadFist : Fist
{
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Wait;
	Ready:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHIJA 2;
	RealReady:
		ADFS A 1 A_WeaponReady;
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Loop;
	Select:
		ADFS A 1 A_Raise(24);
		Loop;
	Fire:
		ADFS BC 1;
		ADFS D 2 A_Punch;
		ADFS D 2 A_WeaponOffset(2.0, 2.0, WOF_ADD);
		ADFS CBA 3 A_WeaponOffset(0.0, 32.0);
		ADFS A 2 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadChainsaw : Chainsaw
{
	States
	{
	Select:
		ADCS I 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS MLKJI 2;
		TNT1 I 1 A_Lower(24);
		Wait;
	Ready:
		ADCS IJKLM 2;
	RealReady:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS ABCD 2 A_WeaponReady;
		Loop;
	Fire:
		TNT1 A 0 A_StartSound("weapons/sawfull", 6, CHANF_LOOPING, 0.75);
	Hold:
		ADCS E 0 A_Saw("","",2);
		ADCS EFGH 1
		{
			A_WeaponOffset(random(-2.0,2.0), random(32.0,40.0),WOF_INTERPOLATE);
		}
		ADCS A 0 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadPistol : Pistol
{
	Default
	{
		Weapon.BobRangeX 0.75;
		Weapon.BobSpeed 2;
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPS GHIJK 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADPS K 0 A_StartSound("weapons/adpistol/deploy");
		ADPS KJIHGDA 2;
	RealReady:
		ADPS A 1 A_WeaponReady;
		Wait;
	Fire:
		ADPS A 2 Bright
		{
			A_FireBullets (4, 2, 1, 6, "BulletPuff");
			A_StartSound("weapons/adpistol", CHAN_WEAPON);
			A_GunFlash();
		}
		ADPS BB 1 A_WeaponOffset(2.0, 2.0, WOF_ADD);
		ADPS CC 1 A_WeaponOffset(1.0, 3.0, WOF_ADD);
		ADPS D 2 A_WeaponOffset(0.0, 32.0);
		ADPS D 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADPS E 2 Bright A_Light1;
		ADPS F 2 Bright A_Light1;
		Goto LightDone;
 	Spawn:
		ADPS A -1;
		Stop;
	}
}

class DeathsheadMAC10 : Chaingun
{
	Default
	{
		Weapon.BobRangeX 0.5;
		Weapon.BobSpeed 1.5;
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
        Inventory.PickupMessage "Picked up a MAC-10.";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADMC GHI 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADMC I 0 A_StartSound("weapons/mac10/deploy");
		ADMC IHGBA 2;
	RealReady:
		ADMC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADMC A 0 A_GunFlash();
		ADMC AB 2 Bright
		{
			A_FireBullets (7, 4, 1, 5, "BulletPuff");
			A_StartSound("weapons/mac10", CHAN_WEAPON);
			A_WeaponOffset(random(-4.0,8.0), random(32.0,48.0),WOF_INTERPOLATE);
		}
		ADMC A 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADMC CE 1 Bright A_Light1;
		ADMC DF 1 Bright A_Light2;
		Goto LightDone;
	Spawn:
		ADMC A -1;
		Stop;
	}
}

class DeathsheadShotgun : Shotgun
{
	Default
	{
		Weapon.BobRangeX 0.75;
		Weapon.BobStyle "InverseSmooth";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADSG GHIJKL 1;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADSG I 0 A_StartSound("weapons/autoshotgun/deploy");
		ADSG LKJIHGA 1;
	RealReady:
		ADSG A 1 A_WeaponReady;
		Loop;
	Fire:
		ADSG C 2 Bright
		{
			A_FireBullets (6, 6, 12, random(2,5), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/autoshotgun", CHAN_AUTO);
			A_GunFlash();
		}
		ADSG B 2 Bright;
		ADSG A 1;
		ADSG A 1 A_ReFire;
		Goto RealReady;
	Flash:
		ADSG D 2 Bright A_Light1;
		ADSG E 2 Bright A_Light2;
		Goto LightDone;
	}
}
