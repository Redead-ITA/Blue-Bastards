class ChainsawReplacement : CustomInventory replaces Chainsaw
{
	Default
	{
		Inventory.PickupMessage "$GOTCHAINSAW";
		Inventory.PickupSound "misc/w_pkup";
		Obituary "$OB_MPCHAINSAW";
		Tag "$TAG_CHAINSAW";
	}
	States
	{
	Spawn:
		CSAW A -1;
		Stop;
	Pickup:
		TNT1 A 0 A_JumpIfInventory("SpotMallet", 1, 2);
		TNT1 A 0 A_JumpIfInventory("DeathsheadFist", 1, 2);
		Stop;
		TNT1 A 0 A_GiveInventory("SpotRustyClaws");
		Stop;
		TNT1 A 0 A_GiveInventory("DeathsheadChainsaw");
		Stop;
	}
}

class ShotgunReplacement : CustomInventory replaces Shotgun
{
	Default
	{
		Inventory.PickupMessage "$GOTSHOTGUN";
		Inventory.PickupSound "misc/w_pkup";
		Obituary "$OB_MPSHOTGUN";
		Tag "$TAG_SHOTGUN";
	}
	States
	{
	Spawn:
		SHOT A -1;
		Stop;
	Pickup:
		TNT1 A 0 A_GiveInventory("Shell",8);
		TNT1 A 0 A_JumpIfInventory("SpotMallet", 1, 2);
		TNT1 A 0 A_JumpIfInventory("DeathsheadFist", 1, 2);
		Stop;
		TNT1 A 0 A_GiveInventory("SpotShotgun");
		Stop;
		TNT1 A 0 A_GiveInventory("DeathsheadShotgun");
		Stop;
	}
}

