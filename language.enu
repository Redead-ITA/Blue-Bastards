LORE_CHARACTERS = "The Blue Bastards";
LORE_ACE = "Ace Deathshead the Moth Bartender";
LORE_ACE_1 = "Young (aged 24), blue polish moth bartender.";
LORE_ACE_2 = "Really likes whiskey and Dr. Gibb.";
LORE_ACE_3 = "After getting wasted and playing RTS games in his home";
LORE_ACE_4 = "Ace found himself in quite the predicament;";
LORE_ACE_5 = "His reserve of Dr. Gibb and whiskey ran out";
LORE_ACE_6 = "in the middle of a demonic invasion.";
LORE_ACE_7 = "Destined to find a six pack, Ace, still wasted, armed up and got to work.";
LORE_SPOT = "Spot the Dino";
LORE_SPOT_1 = "Young artist (aged 23) and goober from the island of Neo-Dinosauria.";
LORE_SPOT_2 = "Usually cheerful and kind (well... used to be before the incident),";
LORE_SPOT_3 = "but ever since Nessie's disappearance, they are enraged,";
LORE_SPOT_4 = "and also hungry, hangry, if you will, looking for food scraps";
LORE_SPOT_5 = "to compenstate for the lack of breakfast.";
LORE_1 = "Spot returns home to notice that Nessie has gone missing.";
LORE_2 = "Spot tries calling her to no avail. He tries calling others";
LORE_3 = "in vain, no signal, everything has gone to shit.";
LORE_4 = "Meanwhile, Deathshead is furious at the lack of Dr. Gibb";
LORE_5 = "and drunkenly mashes buttons at his answering machine to";
LORE_6 = "try to find someone willing to sell him a six pack.";
LORE_7 = "*click*";
LORE_8 = "Deathshead: Blehhh... Hello?";
LORE_9 = "Spot: Uh... H-H-Hello? Please tell me that you've seen Nessie, please!";
LORE_10 = "Deathshead: Need... Dr. Gibb...";
LORE_11 = "The phone hangs up, and shortly after Spot hears banging at the door.";
LORE_12 = "Suddenly, a demon’s head gets smashed into the door, ripping it from the hinges.";
LORE_13 = "In the hallway Deathshead rips the demon’s spine off and stares at Spot next.";
LORE_14 = "Spot: Please don’t hurt me! I beg of you!";
LORE_15 = "Deathshead: Urghhh... Give me a fucken' drink...";


