		Goto RealReady;
	Flash:
		ADM4 L 1 Bright A_Light1;
		ADM4 M 2 Bright A_Light2;
		Goto LightDone;
	Spawn:
		ADMC A -1;
		Stop;
	}
}

class DeathsheadM4Grenade : Grenade
{
	Default
	{
		BounceType "None";
		SeeSound "weapons/m4/grenade";
		DeathSound "weapons/rocklx";
	}
}

class DeathsheadLevelEnter : DoomWeapon
{
	Default
	{
		Tag " ";
		+INVENTORY.UNDROPPABLE
	}
	States
	{
	Select:
		TNT1 A 0 A_JumpIf(skip_intros == true, "Fire");
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		TNT1 A 0 A_Jump(256,"Ready1","Ready2","Ready3","Ready4","Ready5");
	Ready1:
		ADWD A 2 A_StartSound("misc/bottle_open", CHAN_AUTO);
		ADWD BCDEF 2;
		ADWD G 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADWD H 2;
		ADWD F 3;
		ADWD G 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADWD H 2;
		ADWD F 3;
		ADWD G 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADWD H 2;
		ADWD F 3;
		ADWD I 2 A_StartSound("weapons/deagle/deploy", CHAN_AUTO);
		ADWD JKLMNOPQRSTUVW 2;
		TNT1 A 2;
		TNT1 A 2 A_StartSound("misc/glass_break", CHAN_AUTO);
		Goto Fire;
	Ready2:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHKLM 2;
		Goto Fire;
	Ready3:
		ADDR A 2 A_StartSound("misc/can_open", CHAN_AUTO);
		ADDR BCDEFG 2;
		ADDR H 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADDR IJKLMNOPDCBA 2;
		Goto Fire;
	Ready4:
		ADMA ABCDEFGHIJKLMEDCBA 2;
		Goto Fire;
	Ready5:
		ADSM ABCDE 2;
		ADSM F 2 A_StartSound("misc/zippo/open");
		ADSM GHIJKL 2;
		ADSM M 2 A_StartSound("misc/zippo/close");
		ADSM NOPQRS 2;
		Goto Fire;
	Fire:
		TNT1 A 1 A_TakeInventory("DeathsheadLevelEnter");
		Wait;
	}
}