LORE_CHARACTERS = "Niebiescy Gówniarze";
LORE_ACE = "As Trupiogłowy, Barman Ćma";
LORE_ACE_1 = "Młoda (w. 24), niebieska ćma polak.";
LORE_ACE_2 = "Bardzo lubi whisky i Dr. Gibb.";
LORE_ACE_3 = "Po najebaniu się i graniu gier RTS w swoim domu";
LORE_ACE_4 = "As miał bardzo duży kłopot;";
LORE_ACE_5 = "Jego strategiczna rezerwa Dr. Gibb wyczerpała";
LORE_ACE_6 = "się w środku demonicznej inwazji.";
LORE_ACE_7 = "As, nadal upity, wziął spluwy i zabrał się za robotę.";
LORE_SPOT = "Dinuś Spot";
LORE_SPOT_1 = "Młody Arysta (w. 23) i Goober z Wyspy Neo-Dinosauri.";
LORE_SPOT_2 = "Zazwyczaj wesoły i miły (no cóż... przed incydentem...).";
LORE_SPOT_3 = "Ale od czasu zniknięcia Nessie.. on zacząl być wściekly,";
LORE_SPOT_4 = "oraz głodny, albo wściekly z głodu, jeśli tak wolisz, szukająć resztek jedzenia";
LORE_SPOT_5 = "aby zrekompensować to... że zapomiał zjeść śniadania.";
LORE_1 = "Spot wraca do domu aby dowiedzieć się że Nessie zaginęła.";
LORE_2 = "Spot próbuje się dodzwonić do Nessie, brak sygnału.";
LORE_3 = "Próbuje jeszcze zadzwonić po pogotowie, brak sygnału.";
LORE_4 = "Tymczasem, As jest wkurwiony z powodu braku Dr. Gibba";
LORE_5 = "i napierdala po pijaku w telefon aby się dodzwonić do";
LORE_6 = "kogoś kto by mu mógł sprzedać sześciopak Dr. Gibb.";
LORE_7 = "*klik*";
LORE_8 = "As: Błehhh... Halo?";
LORE_9 = "Spot: H-H-Halo? Powiedz mi że widziałeś Nessie, proszę!";
LORE_10 = "As: Potrzebny... Gibb...";
LORE_11 = "Numer się rozłącza, a chwilę póżniej Spot słyszy jakby trzaskanie.";
LORE_12 = "Nagle głowa demona zostaje roztrzaskana na drzwiach, urywając je.";
LORE_13 = "W korytarzu Trupiogłowy rozrywa głowę demona, a potem patrzy na Spota.";
LORE_14 = "Spot: Proszę, nie krzywdź mnie!";
LORE_15 = "Deathshead: Uchhh... Daj mi kurwa drinka...";

