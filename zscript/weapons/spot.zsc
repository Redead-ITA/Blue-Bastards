class SpotMallet : Fist
{
	Default
	{
		+WEAPON.NOALERT
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
	}
	States
	{
	Ready:
		MALL A 1 A_WeaponReady;
		Loop;
	Deselect:
		MALL A 1 A_Lower;
		Loop;
	Select:
		MALL A 1 A_Raise;
		Loop;
	Fire:
		MALL BC 2 A_SetAngle(self.angle + 4);
		MALL C 2;
		Goto Hold_Check;
	Hold_Check:
		MALL C 0{
			if (player.cmd.buttons & BT_ATTACK)
			{
				return ResolveState("Hold");
			} 
			else
			{
				return ResolveState("Swing");
			}
		}
	Hold:
		MALL C 1;
		Goto Hold_Check;
	Swing:
		MALL DEF 1 A_SetAngle(self.angle - 4);
		MALL G 0 A_Recoil(-4);
		MALL G 0;
		MALL G 1{
			int dmg = random(15,50);
			A_SetAngle(self.angle - 4);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 10;
			}
			A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "weapons/mallet", misssound: "weapons/mallet/miss");
		}
		MALL HIJ 1 A_SetAngle(self.angle - 4);
		TNT1 A 10;
		MTCD DCBA 2;
		Goto Ready;
	}
}

class SpotChainsaw : Chainsaw
{
}

class DinkyBlasterAmmo : Ammo
{
    Default
    {
        Inventory.MaxAmount 10;
        Inventory.Amount 10;
        //Inventory.Icon "";
        Inventory.PickupMessage "Picked up... internals of a Dinky Blaster? WHAT?";
    }
}

class DinkyBlaster : Pistol
{
    Default
    {
        Weapon.AmmoGive 10;
        Weapon.AmmoUse 1;
        Weapon.AmmoType "DinkyBlasterAmmo";
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
        +WEAPON.AMMO_OPTIONAL
    }

	States
	{
	Ready:
		DNKB A 1 A_WeaponReady(WRF_ALLOWRELOAD);
		Loop;
	Deselect:
		DNKB A 1 A_Lower;
		Loop;
	Select:
		DNKB A 1 A_Raise;
		Loop;
	Fire:
        DNKB A 0 A_JumpIfNoAmmo("Reload");
        DNKB A 0
        {   
            A_GunFlash();
            A_PlaySound("weapons/blaster/shoot");
        }
		DNKB C 3 A_FireBullets(1, 0, 0, 7, "DinkyPuff");
        DNKB B 3;
        DNKB A 3;
        DNKB A 0 A_ReFire;
        Goto Ready;
    Reload:
		DBSR A 0 A_JumpIfInventory("DinkyBlasterAmmo", 0, "Ready");
        Goto RealReload;
	RealReload:
        DBSR A 0 A_PlaySound("weapons/blaster/reload");
        DBSR ABCDE 2;
        DBSR F 45{
            A_GiveInventory("DinkyBlasterAmmo", 10);
        }
        DBSR GHI 2;
		goto Ready;
    Flash:
        DKFR A 3 Bright A_Light1;
        TNT1 A 1 A_Light0;
        stop;
    Spawn:
        BLST A -1;
        stop;
	}
}

class DinkyPuff : BulletPuff
{
    Default
    {
        RenderStyle "Add";
        Alpha 0.5;
        Scale 0.5;
        +NOBLOCKMAP;
        +NOGRAVITY;
    }
    States
    {
        Melee:
            Goto Spawn;
        Spawn:
            PLSE ABCDE 2 Bright;
            stop;
    }
}

class SpotShotgun : Shotgun
{
	Default{
		Weapon.AmmoType "Shell";
		Weapon.AmmoUse 2;
		Weapon.AmmoGive 8;
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
	}
	States {
		Deselect:
			SHT2 ABCD 2;
			TNT1 A 1 A_Lower(24);
			Wait;
		Select:
			TNT1 A 1 A_Raise(24);
			Wait;
		Ready:
			SHT2 DC 2;
			SHT2 A 0 A_PlaySound("weapons/shotgun/pump");
			SHT2 BA 2;
		RealReady:
			SSHT A 1 A_WeaponReady;
			Loop;
		Fire:
			SSHT A 0
			{
				A_FireBullets(7, 4, 24, 5, "BulletPuff");
				A_Recoil(1);
				A_PlaySound("weapons/shotgun/fire", CHAN_WEAPON);
				A_GunFlash();
				A_SetPitch(self.pitch - 4, WOF_INTERPOLATE);
			}
			SSHT DC 2 A_SetPitch(self.pitch + 2, WOF_INTERPOLATE);
			SSHT A 6;
			SSHT EF 2;
			SSHT A 0 A_PlaySound("weapons/shotgun/pump");
			SSHT GHIJKL 2;
			SSHT KJIHGFE 2;
			SSHT A 0 A_ReFire;
			goto RealReady;
		Flash:
			SSMF A 2 Bright A_Light2;
			SSMF B 2 Bright A_Light1;
			TNT1 A 1 A_Light0;
			stop;
		Spawn:
			BLST A -1;
			stop;
	}
}

class SpotDevastator : SuperShotgun
{
	Default{
		Weapon.AmmoType "Shell";
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 8;
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
	}
	States {
		Deselect:
			DVTR ABCD 2;
			TNT1 A 1 A_Lower(24);
			Wait;
		Select:
			TNT1 A 1 A_Raise(24);
			Wait;
		Ready:
			DVTR DC 2;
			DVTR A 0 A_PlaySound("weapons/autoshotgun/deploy");
			DVTR BA 2;
		RealReady:
			DVST A 1 A_WeaponReady;
			Loop;
		Fire:
			DVST D 0
			{
				A_FireBullets(7, 4, 16, 7, "BulletPuff");
				A_Recoil(1);
				A_PlaySound("weapons/shotgun/fire", CHAN_WEAPON);
				A_GunFlash();
				A_SetPitch(self.pitch - 3, WOF_INTERPOLATE);
			}
			DVST DCB 2 A_SetPitch(self.pitch + 1, WOF_INTERPOLATE);
			DVST A 6;
			goto RealReady;
		Flash:
			DVTF B 2 Bright A_Light2;
			DVTF A 2 Bright A_Light1;
			TNT1 A 1 A_Light0;
			stop;
		Spawn:
			BLST A -1;
			stop;
	}
}

class SpotRustyClaws : Fist
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		+WEAPON.MELEEWEAPON
	}
	States
	{
		Ready:
			CLWI A 1 A_WeaponReady;
			Loop;
		Deselect:
			CLWI A 1 A_Lower;
			Loop;
		Select:
			CLWI A 1 A_Raise;
			Loop;
		Fire:
			CLWI A 0 A_Jump(128,"FireLeft");
			CLWR AB 1;
			CLWR C 1 {
				int dmg = random(5,20);
				A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "weapons/claw/impact", misssound: "weapons/claw/swing");
			}
			CLWR DEF 1;
			Goto Ready;
		FireLeft:
			CLWL AB 1;
			CLWL C 1 {
				int dmg = random(5,20);
				A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "weapons/claw/impact", misssound: "weapons/claw/swing");
			}
			CLWL DEF 1;
			Goto Ready;
	}
}

