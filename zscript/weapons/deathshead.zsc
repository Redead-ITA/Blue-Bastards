class DeathsheadFist : Fist
{
	Default
	{
		Weapon.BobStyle "Smooth";
		Weapon.BobRangeX 1.5;
		+WEAPON.NOALERT
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Wait;
	Ready:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHIJA 2;
	RealReady:
		ADFS A 1 A_WeaponReady(WRF_ALLOWRELOAD);
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Loop;
	Select:
		ADFS A 1 A_Raise(24);
		Loop;
	Fire:
		ADFS BC 1;
		ADFS D 2 
		{
			int dmg = random(8,24);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 10;
			}
			A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "*fist", misssound: "weapons/weakswing");
		}
		ADFS D 2 A_WeaponOffset(2.0, 2.0, WOF_ADD);
		ADFS CBA 3 A_WeaponOffset(0.0, 32.0);
		ADFS A 2 A_ReFire;
		Goto RealReady;
	AltFire:
		ADGB AB 2;
		ADGB C 2 
		{
			int dmg = random(2,48);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 2;
			}
			A_CustomPunch(dmg, norandom:true, pufftype:"BlueBastardBulletPuffStab", range: meleeRange + 20, meleesound: "weapons/claw/impact", misssound: "weapons/weakswing");
		}
		ADGB DE 2;
		ADGB F 2 A_ReFire;
		Goto RealReady;
	Reload:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHIJ 2;
		Goto RealReady;
	}
}

class DeathsheadChainsaw : Chainsaw
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobRangeX 0.5;
	}
	States
	{
	Select:
		ADCS I 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS MLKJI 2;
		TNT1 I 1 A_Lower(24);
		Wait;
	Ready:
		ADCS IJKLM 2;
	RealReady:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS ABCD 2 A_WeaponReady;
		Loop;
	Fire:
		TNT1 A 0 A_StartSound("weapons/sawfull", 6, CHANF_LOOPING, 0.75);
	Hold:
		ADCS E 0 A_Saw("","weapons/chainsaw",2,"BlueBastardBulletPuffSaw");
		ADCS EFGH 1
		{
			A_WeaponOffset(random(-2.0,2.0), random(32.0,40.0),WOF_INTERPOLATE);
		}
		ADCS A 0 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadPistol : Pistol
{
	Default
	{
		Weapon.BobRangeX 0.75;
		Weapon.BobSpeed 2;
		Weapon.BobStyle "InverseSmooth";
		+WEAPON.NOAUTOFIRE
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPS FGHIJKL 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADPS K 0 A_StartSound("weapons/adpistol/deploy");
		ADPS LKJIHGFEA 2;
	RealReady:
		ADPS A 1 A_WeaponReady;
		Wait;
	Fire:
		ADPS B 1 Bright
		{
			A_FireBullets (4, 2, -1, random(8,20), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/adpistol", CHAN_AUTO);
			A_GunFlash();
		}
		ADPS B 1 Bright A_WeaponReady(WRF_NOSWITCH);
		ADPS CD 2 Bright A_WeaponReady(WRF_NOSWITCH);
		ADPS EA 2 A_WeaponReady(WRF_NOSWITCH);
		Goto RealReady;
	Flash:
		ADPS MNO 1 Bright A_Light1;
		Goto LightDone;
 	Spawn:
		ADPS A -1;
		Stop;
	}
}

class DeathsheadMAC10 : Chaingun
{
	Default
	{
		Weapon.BobRangeX 0.5;
		Weapon.BobSpeed 1.5;
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
        Inventory.PickupMessage "Picked up a MAC-10.";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADMC GHI 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADMC I 0 A_StartSound("weapons/mac10/deploy");
		ADMC IHGBA 2;
	RealReady:
		ADMC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADMC A 0 A_GunFlash();
		ADMC AB 2 Bright
		{
			A_FireBullets (7, 4, -1, random(4,20), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/mac10", CHAN_AUTO);
			A_WeaponOffset(random(-4.0,8.0), random(32.0,48.0),WOF_INTERPOLATE);
		}
		ADMC A 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADMC CE 1 Bright A_Light1;
		ADMC DF 1 Bright A_Light2;
		Goto LightDone;
	Spawn:
		ADMC A -1;
		Stop;
	}
}

class DeathsheadShotgun : Shotgun
{
	Default
	{
		Weapon.BobRangeX 0.75;
		Weapon.BobStyle "InverseSmooth";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADSG GHIJKLM 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADSG M 0 A_StartSound("weapons/autoshotgun/deploy");
		ADSG MLKJIHGA 2;
	RealReady:
		ADSG A 1 A_WeaponReady;
		Loop;
	Fire:
		ADSG B 1 Bright
		{
			A_FireBullets (6, 6, 12, random(2,5), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/autoshotgun", CHAN_AUTO);
			A_GunFlash();
		}
		ADSG C 2 Bright;
		ADSG D 2 Bright;
		ADSG EFA 2 A_ReFire;
		Goto RealReady;
	Flash:
		ADSG N 1 Bright A_Light1;
		ADSG O 2 Bright A_Light2;
		ADSG P 2 Bright A_Light2;
		Goto LightDone;
	}
}

class DeathsheadSuperShotgunActive : Inventory 
{ 
	Default
	{
		Inventory.MaxAmount 1; 
	}
}
class DeathsheadSuperShotgun : SuperShotgun
{
	Default
	{
		Weapon.AmmoUse 4;
		Weapon.AmmoGive 16;
		Weapon.BobSpeed 1.75;
		Weapon.BobStyle "InverseSmooth";
	}
    States
	{
	Ready:
		ADDB I 0 A_GiveInventory("DeathsheadSuperShotgunActive");
		ADDB I 0 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB IHGFE 2;
	RealReady:
		ADDB A 0 A_JumpIf(GetPlayerInput(INPUT_BUTTONS) & BT_ATTACK, "Fire");
		ADDB A 1 A_WeaponReady(WRF_NOPRIMARY);
		Goto RealReady;
	LeftReady:
		ADDB I 0 {
			A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
			A_OverlayFlags(OverlayID(),PSPF_ADDWEAPON,0);
			A_OverlayOffset(OverlayID(),0,32);
			A_StartSound("weapons/sshotc", CHAN_AUTO);
		}
		ADDB IHGFE 2;
	LeftRealReady:
		ADDB A 0 A_JumpIf(GetPlayerInput(INPUT_BUTTONS) & BT_ATTACK, "LeftFire");
		ADDB A 1;
		Loop;
	Select:
		ADDB I 0 A_Overlay(2,"LeftSelect");
		ADDB I 1 A_Raise(24);
		Wait;
	LeftSelect:
		TNT1 A 0 A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
		ADDB I 1 A_JumpIf(CountInv("DeathsheadSuperShotgunActive"),"LeftReady");
		Wait;
	Deselect:
		ADDB A 0 {
			A_TakeInventory("DeathsheadSuperShotgunActive");
			A_Overlay(2,"LeftDeselect");
		}
		ADDB EFGHI 2;
		ADDB I 1 A_Lower(24);
		Wait;
	LeftDeselect:
		ADDB A 0 A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
		ADDB EFGHI 2;
		ADDB I 1;
		Wait;
	Fire:
		ADDB B 2 Bright {
			A_FireBullets(12.8, 8.2, 48, random(3,6), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/shotgun/fire", CHAN_AUTO);
			A_StartSound("weapons/doubleshotties", CHAN_AUTO, CHANF_DEFAULT, 0.3);
			A_GunFlash();
		}
		ADDB C 2 Bright;
		ADDB D 2;
		ADDB A 0 A_CheckReload;
		ADDB EFG 2;
		ADDB H 2 A_StartSound("weapons/sshoto", CHAN_AUTO);
		ADDB I 2 A_StartSound("weapons/sshotl", CHAN_AUTO);
		ADDB J 2 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB KLC 2;
		Goto RealReady;
	LeftFire:
		ADDB B 2 Bright A_Overlay(3, "LeftFlash");
		ADDB C 2 Bright;
		ADDB DEFGHIJKLC 2;
		Goto LeftRealReady;
	Flash:
		ADDB M 2 Bright A_Light1;
		ADDB N 2 Bright A_Light2;
		Goto LightDone;
	LeftFlash:
		ADDB M 0 Bright {
			A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
			A_OverlayFlags(OverlayID(),PSPF_ADDWEAPON,0);
			A_OverlayOffset(OverlayID(),0,32);
		}
		ADDB M 2 Bright A_Light1;
		ADDB N 2 Bright A_Light2;
		Stop;
	}
}

class DeathsheadRocketLauncher : RocketLauncher
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobRangeX 1.5;
		Weapon.BobRangeY 0.5;
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADRK JIHGF 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADRK F 0 A_StartSound("weapons/rocket/load");
		ADRK FGHIJA 2;
	RealReady:
		ADRK A 1 A_WeaponReady;
		Loop;
	Fire:
		ADRK B 0
		{
			A_StartSound("weapons/rocket", CHAN_AUTO);
			A_FireMissile();
		}
		ADRK BC 2 Bright A_WeaponOffset(8.0, 8.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK DE 2 Bright A_WeaponOffset(2.0, 2.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK A 0 A_StartSound("weapons/rocket/load", CHAN_AUTO, CHANF_DEFAULT, 0.5);
		ADRK AA 2 Bright A_WeaponOffset(-2.0, -2.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK AA 2 Bright A_WeaponOffset(-8.0, -8.0, WOF_ADD|WOF_INTERPOLATE);
		ADRK A 2 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadPlasmaRifle : PlasmaRifle
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
		Weapon.AmmoUse 5;
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPC GHIJKLM 1;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADPC M 1 A_StartSound("weapons/plasmacannon/deploy");
		ADPC LKJIHGA 1;
	RealReady:
		ADPC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADPC B 2 Bright
		{
			A_StartSound("weapons/plasmacannon", CHAN_WEAPON);
			for (int i = 0; i < 5; i++)
			{
				A_FireProjectile("PlasmaCannonBall",random(-3.0,3.0),false,0,0,0,random(-3.0,3.0));
			}
			A_FireProjectile("PlasmaCannonBall",0,true);
			A_GunFlash();
		}
		ADPC C 2 Bright;
		ADPC DAAAAA 2;
		ADPC A 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADPC E 2 Bright A_Light1;
		ADPC F 2 Bright A_Light1;
		Goto LightDone;
	Spawn:
		PLAS A -1;
		Stop;
	}
}

class PlasmaCannonBall : PlasmaBall
{
	Default
	{
		Damage 4;
		Speed 50;
		SeeSound "";
	}
	States
	{
	Death:
		PLSE A 0 Bright A_Explode(random(1,10),96,0);
		PLSE A 4 Bright A_Explode(random(1,5),56,XF_HURTSOURCE);
		PLSE BCDE 4 Bright;
		Stop;
	}
}

class DeathsheadBFG : BFG9000
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobRangeX 1.5;
		Weapon.BobRangeY 0.5;
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		NBFG AMLKJ 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		NBFG J 0 A_StartSound("weapons/bfgq2/deploy");
		NBFG KLMAA 2;
	RealReady:
		NBFG A 1 A_WeaponReady;
		Loop;
	Fire:
		NBFG A 0 A_StartSound("weapons/bfgq2", CHAN_AUTO); 
		NBFG AAAAAAAAAA 1 Bright A_WeaponOffset(random(-2.0,2.0), random(32.0,34.0),WOF_INTERPOLATE);
		NBFG CCDDBBCCD 1 Bright A_WeaponOffset(random(-4.0,4.0), random(32.0,36.0),WOF_INTERPOLATE);
		NBFG DBBCCDDBB 1 Bright A_WeaponOffset(random(-8.0,8.0), random(32.0,40.0),WOF_INTERPOLATE);
		NBFG E 2 Bright
		{
			A_WeaponOffset(16.0, 48.0, WOF_INTERPOLATE);
			if (player == null)
			{
				return;
			}
			Weapon weap = player.ReadyWeapon;
			if (weap != null && invoker == weap && stateinfo != null && stateinfo.mStateType == STATE_Psprite)
			{
				if (!weap.DepleteAmmo (weap.bAltFire, true, deh.BFGCells))
					return;
			}
			SpawnPlayerMissile("DeathsheadBFGBall", angle, nofreeaim:sv_nobfgaim);
		}
		NBFG F 2 Bright A_WeaponOffset(8.0, 8.0, WOF_ADD|WOF_INTERPOLATE);
		NBFG G 2 Bright A_WeaponOffset(4.0, 4.0, WOF_ADD|WOF_INTERPOLATE);
		NBFG H 2 Bright A_WeaponOffset(-4.0, -4.0, WOF_ADD|WOF_INTERPOLATE);
		NBFG I 2 Bright A_WeaponOffset(-8.0, -8.0, WOF_ADD|WOF_INTERPOLATE);
		NBFG A 2 Bright A_WeaponOffset(-16.0, -16.0, WOF_ADD|WOF_INTERPOLATE);
		NBFG A 18;
		NBFG A 0 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadBFGBall : BFGBall
{
	Default
	{
		Damage 48;
		+FORCEXYBILLBOARD
		+BRIGHT
		+EXTREMEDEATH
	}
	States
	{
	Spawn:
		NBFB ABCD 2;
		Loop;
	Death:
		BFE1 A 8 Bright
		{
			A_Explode(128,128,0);
			A_Explode(64,256,0);
		}
		BFE1 B 8 Bright;
		BFE1 C 8 Bright A_BFGSpray;
		BFE1 DEF 8 Bright;
		Stop;
	}
}


class DeathsheadLevelEnter : DoomWeapon
{
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		TNT1 A 0 A_Jump(256,"Ready1","Ready2","Ready3","Ready4","Ready5");
	Ready1:
		ADWD A 2 A_StartSound("misc/bottle_open", CHAN_AUTO);
		ADWD BCDEF 2;
		ADWD G 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADWD H 2;
		ADWD F 3;
		ADWD G 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADWD H 2;
		ADWD F 3;
		ADWD G 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADWD H 2;
		ADWD F 3;
		ADWD I 2 A_StartSound("weapons/deagle/deploy", CHAN_AUTO);
		ADWD JKLMNOPQRSTUVW 2;
		TNT1 A 2;
		TNT1 A 2 A_StartSound("misc/glass_break", CHAN_AUTO);
		TNT1 A 0 A_TakeInventory("DeathsheadLevelEnter");
		Goto Fire;
	Ready2:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHKLM 2;
		TNT1 A 0 A_TakeInventory("DeathsheadLevelEnter");
		Goto Fire;
	Ready3:
		ADDR A 2 A_StartSound("misc/can_open", CHAN_AUTO);
		ADDR BCDEFG 2;
		ADDR H 2 A_StartSound("misc/drink", CHAN_AUTO);
		ADDR IJKLMNOPDCBA 2;
		TNT1 A 0 A_TakeInventory("DeathsheadLevelEnter");
		Goto Fire;
	Ready4:
		ADMA ABCDEFGHIJKLMEDCBA 2;
		TNT1 A 0 A_TakeInventory("DeathsheadLevelEnter");
		Goto Fire;
	Ready5:
		ADSM ABCDE 2;
		ADSM F 2 A_StartSound("misc/zippo/open");
		ADSM GHIJKL 2;
		ADSM M 2 A_StartSound("misc/zippo/close");
		ADSM NOPQRS 2;
		TNT1 A 0 A_TakeInventory("DeathsheadLevelEnter");
		Goto Fire;
	Fire:
		TNT1 A 1;
		Wait;
	}
}
