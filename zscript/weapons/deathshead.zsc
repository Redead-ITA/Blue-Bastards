#include "./deathshead/ammo.zsc" //Custom ammo types
#include "./deathshead/intros.zsc"
#include "./deathshead/melee.zsc" //Includes fists, chainsaw and the kick.
#include "./deathshead/bullet.zsc" //Includes all weapons that use bullets.
#include "./deathshead/shells.zsc" //Includes all weapons that use shells.
#include "./deathshead/rockets.zsc"//etc
#include "./deathshead/cells.zsc"//etc


mixin class BBDeathsheadWeapon  //the mixing classes are classes you add in to the class, which is great for more minor stuff.
{
	default //Side note, DO NOT put this mixin in anything that is not weapon related or it will cause errors.
	{
		Weapon.BobRangeX 0.5;
		Weapon.BobStyle "InverseSmooth";
		Inventory.RestrictedTo "Deathshead"; //If you want to make sure the custom inventory is only for a certain character, just copy paste this.
	}
}