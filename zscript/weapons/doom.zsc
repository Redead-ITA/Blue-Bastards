class ChainsawReplacement : CustomInventory replaces Chainsaw
{
	Default
	{
		Inventory.PickupMessage "$GOTSLOT1";
		Inventory.PickupSound "misc/metalslug";
		Tag "$TAG_CHAINSAW";
	}
	States
	{
	Spawn:
		WPN1 A 8;
		WPN1 A 8 Bright;
		WPN1 AABC 2;
		WPN1 DEFG 2 Bright;
		WPN1 HIJA 2;
		WPN1 A 8 Bright;
		Loop;
	Pickup:
		TNT1 A 0
		{
			if (CheckInventory("SpotMallet", 1)) A_GiveInventory("SpotChainsaw", 1, false);
			if (CheckInventory("DeathsheadFist", 1)) A_GiveInventory("DeathsheadChainsaw", 1, false);
		}
		Stop;
	}
}

