class DinkyBlaster : Pistol
{
    Default
    {
        Weapon.AmmoGive 20;
        Weapon.AmmoUse 1;
        Weapon.AmmoType "Cell";
    }

	States
	{
	Ready:
		DNKB A 1 A_WeaponReady;
		Loop;
	Deselect:
		DNKB A 1 A_Lower;
		Loop;
	Select:
		DNKB A 1 A_Raise;
		Loop;
	Fire:
        DNKB A 0 A_GunFlash;
		DNKB C 3 A_FireProjectile("DinkyBlasterShot", 0, true, 0, 0, 0);
        DNKB B 4;
        DNKB A 4;
        DNKB A 0 A_ReFire;
        Goto Ready;
    Flash:
        DKFR A 3 Bright A_Light1;
        TNT1 A 1 A_Light0;
        stop;
	}
}

class DinkyBlasterShot : PlasmaBall
{
    Default
    {
        Damage 3;
        Speed 50;
        SeeSound "weapons/blaster/shoot";
    }
}