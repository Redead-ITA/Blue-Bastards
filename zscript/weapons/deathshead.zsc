		ADMC DEFGH 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADMC H 2 A_StartSound("weapons/generic/draw");
		ADMC IJKL 2;
		ADMC M 2 A_StartSound("weapons/mac10/deploy");
		ADMC NOPQRS 2;
	RealReady:
		ADMC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADMC A 0 A_GunFlash;
		ADMC BC 2 Bright
		{
			A_FireBullets (7, 4, -1, random(4,12), "BlueBastardBulletPuff", FBF_NORANDOM);
			A_FireBullets (7, 4, -1, random(4,12), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
