class SpotMallet : Fist
{
	Default
	{
		+WEAPON.NOALERT
		+INVENTORY.UNDROPPABLE
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		Tag "$SPOT_MALLET";
		//Weapon.WeaponScaleX 0.75;
		//Weapon.WeaponScaleY 0.8;
	}
	States
	{
	Deselect:
		MTCD ABCDE 3;
		MTCD E 1 A_Lower(24);
		Wait;
	Select:
		MTCD E 1 A_Lower(24);
		Wait;
	Ready:
		MTCD EDC 3;
		MTCD A 0 A_PlaySound("weapons/generic/draw");
		MTCD BA 3;
	RealReady:
		MALL A 1 A_WeaponReady;
		Loop;
	Fire:
		MALL BCD 2 A_SetAngle(self.angle + 4, SPF_INTERPOLATE);
		MALL D 2;
		Goto Hold_Check;
	Hold_Check:
		MALL D 0{
			if (player.cmd.buttons & BT_ATTACK)
			{
				A_WeaponOffset(Random(-3,3),Random(-3,3) + 36);
				return ResolveState("Hold");
			} 
			else
			{
				return ResolveState("Swing");
			}
		}
	Hold:
		MALL D 1;
		Goto Hold_Check;
	Swing:
		MALL DEF 1 A_SetAngle(self.angle - 4, SPF_INTERPOLATE);
		MALL G 0 A_Recoil(-4);
		MALL G 0;
		MALL G 1{
			int dmg = random(15,50);
			A_SetAngle(self.angle - 4, SPF_INTERPOLATE);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 10;
			}
			A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "weapons/mallet", misssound: "weapons/mallet/miss");
		}
		MALL HIJ 1 A_SetAngle(self.angle - 4, SPF_INTERPOLATE);
		TNT1 A 10;
		MTCD EDCBA 3;
		Goto RealReady;
	}
}

class SpotExpress600 : Pistol
{
    Default
    {
        Weapon.AmmoUse 2;
        Weapon.AmmoType "Clip";
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		Tag "$SPOT_REV";
		
		+INVENTORY.UNDROPPABLE
    }

	States
	{
	Deselect:
		REVR ABCDE 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Ready:
		REVR EDC 2;
		REVR A 0 A_PlaySound("weapons/generic/draw");
		REVR BA 2;
	RealReady:
		BREV A 1 A_WeaponReady;
		Loop;
	Fire:
		BREV A 0 A_PlaySound("weapons/express600/prefire");
        BREV BBBBBBBBBB 1{
			A_WeaponOffset(Random(-3,3),Random(-3,3) + 36);
		}
        BREV A 2
        {   
            A_GunFlash();
			A_FireBullets(4,0,0,24, "BlueBastardBulletPuff");
            A_PlaySound("weapons/express600/fire", CHAN_WEAPON);
			A_SetPitch(self.pitch - 6, SPF_INTERPOLATE);
        }
		BREV C 0 A_Recoil(1);
		BREV CD 2 A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
		BREV E 2{
			A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
			A_ReFire();
		}
        Goto RealReady;
    Flash:
        REVF A 2 Bright A_Light1;
        TNT1 A 1 A_Light0;
        stop;
	}
}

class SpotShotgun : Shotgun
{
	Default{
		Weapon.AmmoType "Shell";
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 8;
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		Tag "$SPOT_KS23";

		+INVENTORY.UNDROPPABLE
	}
	States {
		Deselect:
			SSHR ABCDE 2;
			TNT1 A 1 A_Lower(24);
			Wait;
		Select:
			TNT1 A 1 A_Raise(24);
			Wait;
		Ready:
			TNT1 A 0 A_PlaySound("weapons/generic/draw");
			SSHR EDCBA 2;
			SSHT BCD 2;
			SSHT A 0 A_PlaySound("weapons/shotgun/pump");
			SSHT EF 2;
			SSHT EDCBA 2;
		RealReady:
			SSHT A 1 A_WeaponReady;
			Loop;
		Fire:
			SSTF A 0
			{
				A_FireBullets(7, 4, 25, 5, "BlueBastardBulletPuff");
				A_Recoil(1);
				A_PlaySound("weapons/ks23/fire", CHAN_WEAPON);
				A_GunFlash();
				A_SetPitch(self.pitch - 6, SPF_INTERPOLATE);
			}
			SSTF CBAA 1{
				A_SetPitch(self.pitch + 1, SPF_INTERPOLATE);
				A_WeaponOffset(Random(-2,2),Random(-2,2) + 36);
			}
			SSHT A 6;
			SSHT BCD 2;
			SSHT A 0 A_PlaySound("weapons/shotgun/pump");
			SSHT EF 2;
			SSHT EDCBA 2;
			SSHT A 0 A_ReFire;
			goto RealReady;
		Flash:
			SHTF A 1 Bright A_Light2;
			SHTF B 1 Bright A_Light1;
			TNT1 A 1 A_Light0;
			stop;
	}
}

