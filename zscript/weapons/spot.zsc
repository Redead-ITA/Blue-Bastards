class SpotLevelEnter : DoomWeapon
{
	Default
	{
		Tag " ";
		+INVENTORY.UNDROPPABLE
	}
	States
	{
	Select:
		TNT1 A 0 A_JumpIf(skip_intros == true, "Fire");
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		TNT1 A 0 A_Jump(256, "Ready1", "Ready2", "Ready3");
	Ready1:
		SPHN A 0 A_PlaySound("weapons/generic/draw");
		SPHN ABCD 4;
		SPHN E 60 A_PlaySound("misc/phone/sorry");
		// anyone who writes clean code will kill me.
		SPHN EEEEEEEEEEEEEEEEEEEEEEEEEEEEEE 1 {
			A_WeaponOffset(Random(-2,2),Random(-2,2)+15, WOF_INTERPOLATE);
		}
		SPHN FGH 4;
		SPHN A 0 A_PlaySound("weapons/mallet/miss");
		SPHN IJKLM 1;
		TNT1 A 0 A_PlaySound("misc/phone/break", CHAN_6);
		TNT1 A 0 A_QuakeEx(0.2,0.2,0.2, 35, 0, QF_RELATIVE, "");
		Goto Fire;
	Ready2:
		SVDK A 0 A_PlaySound("weapons/generic/draw");
		SVDK AB 2;
		SVDK A 0 A_PlaySound("misc/drink_alt");
		SVDK CD 2;
		SVDK EFGFEFGFE 3;
		SVDK DCBA 2;
		SPDB ABCDEDCBABCDEDCBA 2;
		Goto Fire;
	Ready3:
		SCRK ABCDE 2;
		SCRK F 2 A_PlaySound("weapons/fists/deploy");
		SCRK EDCBA 2;
		Goto Fire;
	Fire:
		TNT1 A 1 A_TakeInventory("SpotLevelEnter");
		Wait;
	}
}

class SpotKicky : CustomInventory
{
    States
    {
    Use:
		TNT1 A 0 {
			int kick_type = random(1,2);
			if (kick_type == 1){
				A_Overlay(-2,"Kicky",1);
			}
			else{
				A_Overlay(-2,"RoadHouse",1);
			}
		}
        TNT1 A 0 A_OverlayOffset(-2,0,16);
        Fail;
    Kicky:
        SKCK A 1 A_StartSound("weapons/kick/miss",CHAN_AUTO);
		SKCK BC 1;
        SKCK D 2 {
			int dmg = random(10,20);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 6;
			}
			A_CustomPunch(dmg, norandom:true, pufftype: "BlueBastardKickPuff", range: meleeRange + 20, meleesound: "weapons/kick", misssound: "");
		}
        SKCK EFGHA 2;
        Stop;
	RoadHouse:
		SRDH A 1 A_StartSound("weapons/kick/miss",CHAN_AUTO);
		SRDH B 1;
        SRDH C 2 {
			int dmg = random(10,20);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 6;
			}
			A_CustomPunch(dmg, norandom:true, pufftype: "BlueBastardKickPuff", range: meleeRange + 20, meleesound: "weapons/kick", misssound: "");
		}
        SRDH DEFGH 2;
        Stop;
    }
}