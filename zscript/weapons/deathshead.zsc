class DeathsheadFist : Fist
{
	Default
	{
		Weapon.BobStyle "Smooth";
		Weapon.BobRangeX 1.5;
		+WEAPON.NOALERT
		+INVENTORY.UNDROPPABLE
		Tag "$ACE_FISTS";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Wait;
	Ready:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHIJA 2;
	RealReady:
		ADFS A 1 A_WeaponReady(WRF_ALLOWRELOAD);
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Loop;
	Select:
		ADFS A 1 A_Raise(24);
		Loop;
	Fire:
		ADFS BC 1;
		ADFS D 2 
		{
			int dmg = random(8,24);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 10;
			}
			A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "*fist", misssound: "weapons/weakswing");
		}
		ADFS D 2 A_WeaponOffset(2.0, 2.0, WOF_ADD);
		ADFS CBA 3 A_WeaponOffset(0.0, 32.0);
		ADFS A 2 A_ReFire;
		Goto RealReady;
	AltFire:
		ADGB AB 2;
		ADGB C 2 
		{
			int dmg = random(2,48);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 2;
			}
			A_CustomPunch(dmg, norandom:true, pufftype:"BlueBastardBulletPuffStab", range: meleeRange + 20, meleesound: "weapons/claw/impact", misssound: "weapons/weakswing");
		}
		ADGB DE 2;
		ADGB F 2 A_ReFire;
		Goto RealReady;
	Reload:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHIJ 2;
		Goto RealReady;
	}
}

class DeathsheadChainsaw : Chainsaw
{
	Default
	{
		Weapon.UpSound "";
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobRangeX 0.5;
		Tag "$ACE_CHAINSAW";
		+INVENTORY.UNDROPPABLE
	}
	States
	{
	Select:
		ADCS N 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS KLMN 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADCS N 2 A_StartSound("weapons/generic/draw", CHAN_AUTO);
		ADCS OPQRSTU 2;
		ADCS V 2 A_StartSound("weapons/chainsaw/start", CHAN_AUTO);
		ADCS W 2 A_StartSound("weapons/sawup", CHAN_AUTO);
		ADCS XYZ[D 2;
	RealReady:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS ABCD 2 A_WeaponReady;
		Loop;
	Fire:
		TNT1 A 0 A_StartSound("weapons/sawfull", 6, CHANF_LOOPING, 0.75);
		ADCS E 1;
	Hold:
		ADCS F 0 A_Saw("","weapons/chainsaw",2,"BlueBastardBulletPuffSaw");
		ADCS FG 1
		{
			A_WeaponOffset(random(-2.0,2.0), random(32.0,40.0),WOF_INTERPOLATE);
		}
		ADCS H 0 A_Saw("","weapons/chainsaw",2,"BlueBastardBulletPuffSaw");
		ADCS HI 1
		{
			A_WeaponOffset(random(-2.0,2.0), random(32.0,40.0),WOF_INTERPOLATE);
		}
		ADCS J 1 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadPistol : Pistol
{
	Default
	{
		Weapon.BobRangeX 0.5;
		Weapon.BobSpeed 1.5;
		Weapon.BobStyle "InverseSmooth";
		+WEAPON.NOAUTOFIRE
		+INVENTORY.UNDROPPABLE
		Tag "$ACE_PISTOL";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPS FGHIJKL 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADPS L 2 A_StartSound("weapons/adpistol/deploy");
		ADPS KJIHGFEA 2;
	RealReady:
		ADPS A 1 A_WeaponReady;
		Wait;
	Fire:
		ADPS B 1 Bright
		{
			A_FireBullets (4, 2, -1, random(8,20), "BlueBastardBulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/adpistol", CHAN_AUTO);
			A_GunFlash();
		}
		ADPS B 1 Bright A_WeaponReady(WRF_NOSWITCH);
		ADPS CD 2 Bright A_WeaponReady(WRF_NOSWITCH);
		ADPS EA 2 A_WeaponReady(WRF_NOSWITCH);
		Goto RealReady;
	Flash:
		ADPS M 2 Bright A_Light2;
		ADPS N 2 Bright A_Light1;
		Goto LightDone;
 	Spawn:
		ADPS A -1;
		Stop;
	}
}

class DeathsheadMAC10 : Chaingun
{
	Default
	{
		Weapon.BobRangeX 0.5;
		Weapon.BobSpeed 1.5;
