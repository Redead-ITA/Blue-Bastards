class DeathsheadFist : Fist
{
	Default
	{
		Weapon.BobStyle "Smooth";
		Weapon.BobRangeX 1.5;
		+WEAPON.NOALERT
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Wait;
	Ready:
		ADFS HG 2;
		ADFS E 2 A_StartSound("weapons/fists/deploy");
		ADFS FGHIJA 2;
	RealReady:
		ADFS A 1 A_WeaponReady;
		Wait;
	Deselect:
		ADFS A 1 A_Lower(24);
		Loop;
	Select:
		ADFS A 1 A_Raise(24);
		Loop;
	Fire:
		ADFS BC 1;
		ADFS D 2 
		{
			int dmg = random(8,24);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 10;
			}
			A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "*fist", misssound: "weapons/weakswing");
		}
		ADFS D 2 A_WeaponOffset(2.0, 2.0, WOF_ADD);
		ADFS CBA 3 A_WeaponOffset(0.0, 32.0);
		ADFS A 2 A_ReFire;
		Goto RealReady;
	AltFire:
		ADGB AB 2;
		ADGB C 2 
		{
			int dmg = random(2,32);
			if (FindInventory("PowerStrength"))
			{
				dmg *= 3;
			}
			A_CustomPunch(dmg, norandom:true, range: meleeRange + 20, meleesound: "weapons/claw/impact", misssound: "weapons/weakswing");
		}
		ADGB DE 2;
		ADGB F 2 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadChainsaw : Chainsaw
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobRangeX 0.5;
	}
	States
	{
	Select:
		ADCS I 1 A_Raise(24);
		Wait;
	Deselect:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS MLKJI 2;
		TNT1 I 1 A_Lower(24);
		Wait;
	Ready:
		ADCS IJKLM 2;
	RealReady:
		TNT1 A 0 A_StopSound(6);
		TNT1 A 0 A_StopSound(7);
		TNT1 A 0 A_StartSound("weapons/sawidle", 7, CHANF_DEFAULT, 0.75);
		ADCS ABCD 2 A_WeaponReady;
		Loop;
	Fire:
		TNT1 A 0 A_StartSound("weapons/sawfull", 6, CHANF_LOOPING, 0.75);
	Hold:
		ADCS E 0 A_Saw("","",2);
		ADCS EFGH 1
		{
			A_WeaponOffset(random(-2.0,2.0), random(32.0,40.0),WOF_INTERPOLATE);
		}
		ADCS A 0 A_ReFire;
		Goto RealReady;
	}
}

class DeathsheadPistol : Pistol
{
	Default
	{
		Weapon.BobRangeX 0.75;
		Weapon.BobSpeed 2;
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPS GHIJK 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADPS K 0 A_StartSound("weapons/adpistol/deploy");
		ADPS KJIHGDA 2;
	RealReady:
		ADPS A 1 A_WeaponReady;
		Wait;
	Fire:
		ADPS A 2 Bright
		{
			A_FireBullets (4, 2, 1, 6, "BulletPuff");
			A_StartSound("weapons/adpistol", CHAN_WEAPON);
			A_GunFlash();
		}
		ADPS BB 1 A_WeaponOffset(2.0, 2.0, WOF_ADD);
		ADPS CC 1 A_WeaponOffset(1.0, 3.0, WOF_ADD);
		ADPS D 2 A_WeaponOffset(0.0, 32.0);
		ADPS D 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADPS E 2 Bright A_Light1;
		ADPS F 2 Bright A_Light1;
		Goto LightDone;
 	Spawn:
		ADPS A -1;
		Stop;
	}
}

class DeathsheadMAC10 : Chaingun
{
	Default
	{
		Weapon.BobRangeX 0.5;
		Weapon.BobSpeed 1.5;
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
        Inventory.PickupMessage "Picked up a MAC-10.";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADMC GHI 2;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADMC I 0 A_StartSound("weapons/mac10/deploy");
		ADMC IHGBA 2;
	RealReady:
		ADMC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADMC A 0 A_GunFlash();
		ADMC AB 2 Bright
		{
			A_FireBullets (7, 4, 1, 5, "BulletPuff");
			A_StartSound("weapons/mac10", CHAN_WEAPON);
			A_WeaponOffset(random(-4.0,8.0), random(32.0,48.0),WOF_INTERPOLATE);
		}
		ADMC A 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADMC CE 1 Bright A_Light1;
		ADMC DF 1 Bright A_Light2;
		Goto LightDone;
	Spawn:
		ADMC A -1;
		Stop;
	}
}

class DeathsheadShotgun : Shotgun
{
	Default
	{
		Weapon.BobRangeX 0.75;
		Weapon.BobStyle "InverseSmooth";
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADSG GHIJKL 1;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADSG I 0 A_StartSound("weapons/autoshotgun/deploy");
		ADSG LKJIHGA 1;
	RealReady:
		ADSG A 1 A_WeaponReady;
		Loop;
	Fire:
		ADSG C 2 Bright
		{
			A_FireBullets (6, 6, 12, random(2,5), "BulletPuff", FBF_USEAMMO|FBF_NORANDOM);
			A_StartSound("weapons/autoshotgun", CHAN_AUTO);
			A_GunFlash();
		}
		ADSG B 2 Bright;
		ADSG A 1;
		ADSG A 1 A_ReFire;
		Goto RealReady;
	Flash:
		ADSG D 2 Bright A_Light1;
		ADSG E 2 Bright A_Light2;
		Goto LightDone;
	}
}

class DeathsheadSuperShotgunActive : Inventory 
{ 
	Default
	{
		Inventory.MaxAmount 1; 
	}
}
class DeathsheadSuperShotgunVeryActive : DeathsheadSuperShotgunActive {}
class DeathsheadSuperShotgun : SuperShotgun
{
	Default
	{
		Weapon.BobSpeed 1.75;
		Weapon.BobStyle "InverseSmooth";
	}
    States
	{
	Ready:
		ADDB I 0 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB IHGFE 2;
	RealReady:
		ADDB A 0 A_GiveInventory("DeathsheadSuperShotgunActive");
		ADDB A 0 A_JumpIf(CountInv("DeathsheadSuperShotgunVeryActive") && GetPlayerInput(INPUT_BUTTONS) & BT_ATTACK, "Fire");
		ADDB A 1 A_WeaponReady(WRF_NOPRIMARY);
		Goto RealReady;
	LeftReady:
		ADDB I 0 {
			A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
			A_OverlayFlags(OverlayID(),PSPF_ADDWEAPON,0);
			A_OverlayOffset(OverlayID(),0,32);
			A_StartSound("weapons/sshotc", CHAN_AUTO);
		}
		ADDB IHGFE 2;
	LeftRealReady:
		ADDB A 0 A_GiveInventory("DeathsheadSuperShotgunVeryActive");
		ADDB A 0 A_JumpIf(GetPlayerInput(INPUT_BUTTONS) & BT_ATTACK, "LeftFire");
		ADDB A 1;
		Loop;
	Select:
		ADDB I 0 A_Overlay(2,"LeftSelect");
		ADDB I 1 A_Raise(24);
		Wait;
	LeftSelect:
		TNT1 A 0 A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
		ADDB I 1 A_JumpIf(CountInv("DeathsheadSuperShotgunActive"),"LeftReady");
		Wait;
	Deselect:
		ADDB A 0 {
			A_TakeInventory("DeathsheadSuperShotgunActive");
			A_Overlay(2,"LeftDeselect");
		}
		ADDB EFGHI 2;
		ADDB I 1 A_Lower(24);
		Wait;
	LeftDeselect:
		ADDB A 0 A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
		ADDB EFGHI 2;
		ADDB I 1;
		Wait;
	Fire:
		ADDB B 2 Bright {
			A_FireBullets(12.6, 8.2, 32, random(2,3));
			A_StartSound("weapons/shotgun/fire", CHAN_AUTO);
			A_StartSound("weapons/doubleshotties", CHAN_AUTO, CHANF_DEFAULT, 0.3);
			A_GunFlash();
		}
		ADDB C 2 Bright;
		ADDB D 2;
		ADDB A 0 A_CheckReload;
		ADDB EFG 2;
		ADDB H 2 A_StartSound("weapons/sshoto", CHAN_AUTO);
		ADDB I 2 A_StartSound("weapons/sshotl", CHAN_AUTO);
		ADDB J 2 A_StartSound("weapons/sshotc", CHAN_AUTO);
		ADDB KLC 2;
		Goto RealReady;
	LeftFire:
		ADDB B 2 Bright A_Overlay(3, "LeftFlash");
		ADDB C 2 Bright;
		ADDB DEFGHIJKLC 2;
		Goto LeftRealReady;
	Flash:
		ADDB M 2 Bright A_Light1;
		ADDB N 2 Bright A_Light2;
		Goto LightDone;
	LeftFlash:
		ADDB M 0 Bright {
			A_OverlayFlags(OverlayID(),PSPF_MIRROR|PSPF_FLIP,1);
			A_OverlayFlags(OverlayID(),PSPF_ADDWEAPON,0);
			A_OverlayOffset(OverlayID(),0,32);
		}
		ADDB M 2 Bright A_Light1;
		ADDB N 2 Bright A_Light2;
		Stop;
	}
}

class DeathsheadPlasmaRifle : PlasmaRifle
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.WeaponScaleX 0.9;
		Weapon.WeaponScaleY 1.08;
		Weapon.AmmoUse 5;
	}
	States
	{
	Select:
		TNT1 A 1 A_Raise(24);
		Wait;
	Deselect:
		ADPC GHIJKLM 1;
		TNT1 A 1 A_Lower(24);
		Wait;
	Ready:
		ADPC M 1 A_StartSound("weapons/plasmacannon/deploy");
		ADPC LKJIHGA 1;
	RealReady:
		ADPC A 1 A_WeaponReady;
		Loop;
	Fire:
		ADPC B 2 Bright
		{
			A_StartSound("weapons/plasmacannon", CHAN_WEAPON);
			for (int i = 0; i < 5; i++)
			{
				A_FireProjectile("PlasmaCannonBall",random(-3.0,3.0),false,0,0,0,random(-3.0,3.0));
			}
			A_FireProjectile("PlasmaCannonBall",0,true);
			A_GunFlash();
		}
		ADPC C 2 Bright;
		ADPC DAAAAA 2;
		ADPC A 0 A_ReFire;
		Goto RealReady;
	Flash:
		ADPC E 2 Bright A_Light1;
		ADPC F 2 Bright A_Light1;
		Goto LightDone;
	Spawn:
		PLAS A -1;
		Stop;
	}
}


class PlasmaCannonBall : PlasmaBall
{
	Default
	{
		Damage 4;
		Speed 50;
		SeeSound "";
	}
	States
	{
	Death:
		PLSE A 4 Bright A_Explode(random(1,4),64);
		PLSE BCDE 4 Bright;
		Stop;
	}
}
