class SpotChainsaw : Chainsaw
{
	Default
	{
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		Weapon.UpSound "";
		+WEAPON.MELEEWEAPON
		Tag "$SPOT_CHAINSAW";

		+INVENTORY.UNDROPPABLE
	}
	States
	{
		Deselect:
			SSWR ABCDE 2 A_StopSound(CHAN_6);
			TNT1 A 1 A_Lower(24);
			Wait;
		Select:
			TNT1 A 1 A_Raise(24);
			Wait;
		Ready:
			SSWR EDC 2;
			SSWP A 0 A_PlaySound("weapons/chainsaw/pull", CHAN_AUTO);
			SSWP ABC 2;
			SSWP DDEEFF 1 {
				A_WeaponOffset(Random(-2,2),Random(-2,2) + 36);
			}
			SSWP A 0 A_PlaySound("weapons/chainsaw/idle", CHAN_6, 1.0, true);
			SSWR BBAA 1 A_WeaponOffset(Random(-2,2),Random(-2,2) + 36);
		RealReady:
			SSAW AABBCCDD 1{
				A_WeaponReady();
				A_WeaponOffset(Random(-1,1),Random(-1,1) + 36);
			}
			Loop;
		Fire:
			SSWT A 1;
		RealFire:
			SSWP A 0 A_PlaySound("weapons/chainsaw/attack", CHAN_6, 1.0, true);
			SSWP A 0 A_Saw("","weapons/chainsaw",2,"BlueBastardBulletPuffSaw");
			SSWA AB 1 {
				A_WeaponOffset(Random(-3,3),Random(-3,3) + 36);
			}
			SSWA A 0 A_ReFire("RealFire");
			SSWT A 1;
			SSWP A 0 A_PlaySound("weapons/chainsaw/idle", CHAN_6, 1.0, true);
			Goto RealReady;
	}
}

class SpotRocketLauncher : RocketLauncher
{
		Default{
		Weapon.AmmoType "RocketAmmo";
		Weapon.AmmoUse 1;
		Weapon.AmmoGive 4;
		Weapon.BobStyle "InverseSmooth";
		Weapon.BobSpeed 1.75;
		Weapon.BobRangeX 1.2;
		Weapon.BobRangeY 0.6;
		+WEAPON.NOAUTOFIRE
		+INVENTORY.UNDROPPABLE

		Tag "$SPOT_ROCKET";
	}
	States {
		Deselect:
			SMSR ABCDE 2;
			TNT1 A 1 A_Lower(24);
			Wait;
		Select:
			TNT1 A 1 A_Raise(24);
			Wait;
		Ready:
			SMSR EDC 2;
			SMSR A 0 A_PlaySound("weapons/missle/deploy");
			SMSR BA 2;
		RealReady:
			SMSL A 1 A_WeaponReady;
			Loop;
		Fire:
			SMSL A 0{
				A_FireProjectile("NapalmRocket", 1, true, -10, -10);
				A_FireProjectile("NapalmRocket", 1, true, -10, 10);
				A_FireProjectile("NapalmRocket", -1, true, 10, -10);
				A_FireProjectile("NapalmRocket", -1, true, 10, 10);
				A_Light(4);
				A_SetPitch(self.pitch - 6, SPF_INTERPOLATE);
			}
			SMSL BC 1{
				A_Light(2);
				A_WeaponOffset(Random(-2,2),Random(-2,2) + 36);
				A_SetPitch(self.pitch + 2, SPF_INTERPOLATE);
			}
			SMSL DDDDDDDDDDDD 1{
				A_Light0();
				A_WeaponOffset(Random(-4,4),Random(-4,4) + 36);
			}
			SMSL DDDDDDD 2{
				A_WeaponOffset(Random(-2,2),Random(-2,2) + 36);
			}
			SMSL A 0 A_Light0();
			SMSL DEF 2;
			SMSL A 0{;
				A_ReFire();
			}
			goto RealReady;
	}
}

