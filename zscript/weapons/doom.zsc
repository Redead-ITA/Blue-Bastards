class BBShell : BBAmmo replaces Shell
{
	Default
	{
		Inventory.PickupMessage "$GOTSHELLS";
		/*Inventory.Amount 4;
		Inventory.MaxAmount 50;
		Ammo.BackpackAmount 4;
		Ammo.BackpackMaxAmount 100;
		Inventory.Icon "SHELA0";*/
		Tag "$AMMO_SHELLS";
	}
	States
	{
	Spawn:
		SHEL A -1;
		Stop;
	Pickup:
		TNT1 A 0
		{
			A_GiveInventory("Shell", A_ammomultiplier(4), false);
			if (CheckInventory("SpotMallet", 1)) 
			{
				A_GiveInventory("BBSpotDevastatorShell", A_ammomultiplier(4), false);
			}
			if (CheckInventory("DeathsheadFist", 1)){ }
		}
		Stop;
	}
}

